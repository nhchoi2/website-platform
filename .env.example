# local = 로컬 시연 전용. Vercel에서는 반드시 supabase.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
# 쉼표로 구분한 관리 서비스 호스트. 고객 도메인은 여기에 넣지 않습니다.
PLATFORM_HOSTS=127.0.0.1:3000,localhost:3000
# 로컬 파일 저장 위치. Git에 포함하지 않습니다.
LOCAL_DATA_DIR=.local-data

# APP_MODE=supabase 일 때 필수. 모두 서버에서만 사용합니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Production: APP_URL=https://sites.koofy.co.kr
# PLATFORM_HOSTS=sites.koofy.co.kr,website-platform-one.vercel.app

# Supabase Google provider configuration must be completed before enabling.
# OAuth Client Secret belongs in Supabase Auth settings, never NEXT_PUBLIC_* or Git.
GOOGLE_AUTH_ENABLED=false
# Publish only after operator details and privacy/vendor conditions are finalized.
LEGAL_PUBLISHED=false
SERVICE_OPERATOR_NAME=
SERVICE_OPERATOR_ADDRESS=
SERVICE_OPERATOR_NUMBER=
PRIVACY_CONTACT_NAME=

# Enable only after migrations 005~009 and consultation privacy/vendor review.
# Local mode always provides a clearly labeled local-only demonstration.
INQUIRIES_ENABLED=false

# New workflow: apply migrations 006~009 before deploying this release.
# Actual mail is disabled by default. Local mode only records a demonstration.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_ADMIN_EMAIL=koofylab@gmail.com
NOTIFICATION_REPLY_TO=koofylab@gmail.com
# Browser-visible restricted Embed API key; never reuse a privileged server secret.
GOOGLE_MAPS_EMBED_KEY=
