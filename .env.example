# local = 로컬 시연 전용. Vercel에서는 반드시 supabase.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
# 쉼표로 구분한 관리 서비스 호스트. 고객 도메인은 여기에 넣지 않습니다.
PLATFORM_HOSTS=127.0.0.1:3000,localhost:3000
# 로컬 파일 저장 위치. Git에 포함하지 않습니다.
LOCAL_DATA_DIR=.local-data

# APP_MODE=supabase 일 때 필수. 모두 서버에서만 사용합니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Production: APP_URL=https://sites.koofy.co.kr
# PLATFORM_HOSTS=sites.koofy.co.kr,website-platform-one.vercel.app
